# Copie este arquivo para ".env" e preencha as chaves. O ".env" NUNCA deve ser enviado ao GitHub.
# Chave gratuita do AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=cole_sua_chave_aqui

# Chave gratuita do VirusTotal (conta Community): https://www.virustotal.com/gui/my-apikey
VT_API_KEY=cole_sua_chave_aqui

# Opcional: ajustar limites (os padrões seguem os planos gratuitos)
# ABUSEIPDB_DAILY_LIMIT=1000
# VT_REQUESTS_PER_MINUTE=4
# VT_REQUESTS_PER_DAY=500
